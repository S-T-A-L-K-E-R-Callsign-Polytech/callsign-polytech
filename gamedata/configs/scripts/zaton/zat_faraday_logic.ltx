[logic]
active = remark@base

[remark@base]
anim                     = guard_na
target                   = story | actor
meet                     = meet
on_actor_dist_le         = 10 | {+zat_polytech_router_task_given -zat_polytech_router_faraday_met} remark@stop
on_info                  = {+zat_polytech_router_faraday_gave -zat_polytech_router_faraday_freed !talking} %+zat_polytech_router_faraday_freed =polytech_replace_with_squad(zat_faraday_squad:zat_stalker_base_smart)%
gather_items_enabled     = false
help_wounded_enabled     = false
corpse_detection_enabled = false

[remark@stop]
anim                     = threat_na
target                   = story | actor
meet                     = meet@stop
on_info                  = {+zat_polytech_router_force} remark@fight %=actor_enemy%
on_info2                 = {+zat_polytech_router_escort} polytech_lead@escort
on_actor_dist_ge         = 25 | remark@base
gather_items_enabled     = false
help_wounded_enabled     = false
corpse_detection_enabled = false

[remark@fight]
anim                     = threat_na
target                   = story | actor
meet                     = no_meet
gather_items_enabled     = false
help_wounded_enabled     = false
corpse_detection_enabled = false

[polytech_lead@escort]
dest                     = zat_polytech
meet                     = no_meet
on_info                  = {-zat_polytech_router_bandits_spawned} %+zat_polytech_router_bandits_spawned =polytech_ambush(zat_polytech_bandits:zat_b5_smart_terrain:zat_polytech:140)%
on_signal                = arrived | {=distance_to_obj_le(zat_faraday:10)} remark@base %+zat_polytech_router_escorted%
gather_items_enabled     = false
help_wounded_enabled     = false
corpse_detection_enabled = false

[meet]
close_distance  = 0
close_anim      = nil
close_snd_hello = nil
close_snd_bye   = nil
close_victim    = nil
far_distance    = 0
far_anim        = nil
far_victim      = nil
use             = {=actor_enemy} false, true
allow_break     = false
trade_enable    = false
meet_on_talking = false

[meet@stop]
close_distance  = 0
close_anim      = nil
close_snd_hello = nil
close_snd_bye   = nil
close_victim    = nil
far_distance    = 0
far_anim        = nil
far_victim      = nil
use             = {=actor_enemy} false, self
meet_dialog     = zat_faraday_router_meet
allow_break     = false
trade_enable    = false
meet_on_talking = false
