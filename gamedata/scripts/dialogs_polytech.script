local function faraday_is_alive()
    local id = get_story_object_id("zat_faraday")
    local se = id and alife():object(id)
    return se ~= nil and se:alive()
end

function router_give_task(first_speaker, second_speaker)
    task_manager.get_task_manager():give_task("zat_polytech_router")
end

function actor_has_router(first_speaker, second_speaker)
    return db.actor:object("zat_rokovoy_router") ~= nil
end

function faraday_alive(first_speaker, second_speaker)
    return faraday_is_alive()
end

function faraday_dead(first_speaker, second_speaker)
    return not faraday_is_alive()
end

function router_transfer(first_speaker, second_speaker)
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "zat_rokovoy_router")
end

function router_from_faraday(first_speaker, second_speaker)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "zat_rokovoy_router")
end

local function fpga_has(section)
    return db.actor:object(section) ~= nil
end

function fpga_give_task(first_speaker, second_speaker)
    task_manager.get_task_manager():give_task("zat_polytech_fpga")
end

function fpga_has_intact(first_speaker, second_speaker)
    return fpga_has("fice_fpga_board")
end

function fpga_has_only_burnt(first_speaker, second_speaker)
    return fpga_has("burnt_fpga_board") and not fpga_has("fice_fpga_board")
end

function fpga_has_any_board(first_speaker, second_speaker)
    return fpga_has("fice_fpga_board") or fpga_has("burnt_fpga_board")
end

function fpga_has_cheap(first_speaker, second_speaker)
    return fpga_has("cheap_fpga_board")
end

function fpga_reward_full(first_speaker, second_speaker)
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "fice_fpga_board")
    dialogs.relocate_money_to_actor(first_speaker, second_speaker, 5000)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "detector_advanced")
end

function fpga_reward_burnt(first_speaker, second_speaker)
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "burnt_fpga_board")
    dialogs.relocate_money_to_actor(first_speaker, second_speaker, 500)
end

function fpga_give_cheap(first_speaker, second_speaker)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "cheap_fpga_board")
end

function fpga_take_cheap(first_speaker, second_speaker)
    dialogs.relocate_item_section_from_actor(first_speaker, second_speaker, "cheap_fpga_board")
end

function fpga_max_start(first_speaker, second_speaker)
    polytech.spawn_fpga_scene()
end

function fpga_max_finish(first_speaker, second_speaker)
    dialogs.relocate_item_section_to_actor(first_speaker, second_speaker, "energy_drink")
    dialogs.who_is_npc(first_speaker, second_speaker):set_relation(game_object.friend, db.actor)
end
