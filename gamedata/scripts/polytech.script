local function spawn_once(info, section, x, y, z, lvid, gvid)
    if db.actor:has_info(info) then
        return
    end
    local old_id = get_story_object_id(section)
    if old_id then
        alife():release(alife():object(old_id), true)
        story_objects.get_story_objects_registry():unregister_by_story_id(section)
    end
    alife():create(section, vector():set(x, y, z), lvid, gvid)
    db.actor:give_info_portion(info)
end

local function game_vertex_near(pos)
    local graph = game_graph()
    local level_id = graph:vertex(db.actor:game_vertex_id()):level_id()
    local best, best_dist
    local gvid = 0
    while graph:valid_vertex_id(gvid) do
        local vertex = graph:vertex(gvid)
        if vertex:level_id() == level_id then
            local dist = vertex:level_point():distance_to_sqr(pos)
            if not best_dist or dist < best_dist then
                best, best_dist = gvid, dist
            end
        end
        gvid = gvid + 1
    end
    return best
end

local function create_squad_at(squad_section, smart_name, pos, lvid, gvid)
    local board = sim_board.get_sim_board()
    local smart = board.smarts_by_names[smart_name]
    local squad = alife():create(squad_section, pos, lvid, gvid)
    for k, section in pairs(utils.parse_names(system_ini():r_string(squad_section, "npc"))) do
        squad:add_squad_member(section, pos, lvid, gvid, k)
    end
    squad:set_squad_relation()
    board:assign_squad_to_smart(squad, smart.id)
    board:enter_smart(squad, smart.id)
    for k in squad:squad_members() do
        board:setup_squad_and_group(k.object)
    end
    squad:update()
end

local function ambush(actor, npc, p)
    local from = npc:position()
    local to = alife():object(get_story_object_id(p[3])).position
    local dir = vector():set(to.x - from.x, 0, to.z - from.z):normalize()
    local gvid = game_vertex_near(vector():set(from.x + dir.x * p[4], from.y, from.z + dir.z * p[4]))
    local vertex = game_graph():vertex(gvid)
    local pos, lvid = vertex:level_point(), vertex:level_vertex_id()

    create_squad_at(p[1], p[2], pos, lvid, gvid)
end

local function replace_with_squad(actor, npc, p)
    local pos, lvid, gvid = npc:position(), npc:level_vertex_id(), npc:game_vertex_id()
    local story_id = get_object_story_id(npc:id())
    alife():release(alife():object(npc:id()), true)
    if story_id then
        story_objects.get_story_objects_registry():unregister_by_story_id(story_id)
    end
    create_squad_at(p[1], p[2], pos, lvid, gvid)
end

local function register_logic_functions()
    xr_effects.polytech_ambush = ambush
    xr_effects.polytech_replace_with_squad = replace_with_squad
end

function spawn_entities()
    register_logic_functions()
    spawn_once("zat_polytech_spawned", "zat_polytech", 128.43, -7.34, 188.71, 1186463, 298)
    spawn_once("zat_faraday_spawned_v2", "zat_faraday", 472.45, 37.12, 32.91, 1732117, 293)
    spawn_once("zat_max_spawned", "zat_max", -0.539003, -0.506748, 33.662804, 942595, 19)
end

local function spawn_polter_boxes()
    if db.actor:has_info("zat_fpga_boxes_spawned") then return end
    local center = vector():set(-337.445160, 40.061741, -388.426544)
    local center_lvid = 277246
    local sections = {"box_wood_02", "box_1a", "box_1b", "box_1c"}
    local count = 14
    for i = 0, count - 1 do
        local angle = i * (2 * math.pi / count) + (i % 3) * 0.15
        local dist = 6 + ((i * 7) % 5) * 5
        local dir = vector():set(math.cos(angle), 0, math.sin(angle))
        local lvid = level.vertex_in_direction(center_lvid, dir, dist)
        local pos = level.vertex_position(lvid)
        if pos:distance_to(center) >= 5 then
            pos.y = pos.y + 0.1
            alife():create(sections[i % #sections + 1], pos, lvid, 29)
        end
    end
    db.actor:give_info_portion("zat_fpga_boxes_spawned")
end

function spawn_fpga_scene()
    spawn_once("zat_fpga_scene_spawned",  "zat_max_backpack",     -337.445160, 40.561741, -388.426544, 277246, 29)
    spawn_once("zat_fpga_board_spawned",  "fice_fpga_board",      -336.945160, 40.061741, -388.826544, 277246, 29)
    spawn_once("zat_fpga_notes_spawned",  "zat_fpga_notes",       -337.245160, 40.061741, -388.126544, 277246, 29)
    spawn_once("zat_fpga_scanner_spawned","zat_fpga_scanner",     -336.745160, 40.061741, -389.126544, 277246, 29)
    spawn_once("zat_fpga_polter_spawned", "zat_fpga_poltergeist", -337.945160, 40.061741, -388.026544, 277246, 29)
    spawn_polter_boxes()
end
